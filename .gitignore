.claude/settings.local.json
node_modules/
.env
.env.*
*.secret
.vercel/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
Thumbs.db
*.log

# Raw + ledger state are large + immutable: they live in GitHub Release assets,
# never in git history (gameplan 03 §2/§7 hygiene: raw->Release assets, derived->repo).
data/raw/
data/state/
data/releases/
data/reference/*
# ...except the public corrections log: corrections are dated posts that must deploy to the site.
# (glob the dir CONTENTS, not the dir itself, so a single-file re-include is possible.)
!data/reference/corrections.json
!data/reference/corrections-count.json
# ...and the Search's pre-registered reference tables (small, factual, sourced — §S0.4 requires them committed)
!data/reference/search/
!data/reference/search/*.json
# ...and the Article XIII privacy gate: the form list is HASHED (it names nobody) and the allowlist is
# a kill-fixture of legitimate speech. Both are PUBLIC on purpose — the mechanism is auditable, only
# the four name forms are secret. The SALT is NOT here and must never be moved here: assemble.yml
# tars data/reference into a public release asset. (pipeline/privacy.py)
!data/reference/privacy-forms.json
!data/reference/privacy-allowlist.json
# ...and the nomenclature index tables (bill titles + committee names). The daily pipeline reads these
# INSTEAD of touching the network, so they are not rebuildable intermediates — if they are not committed
# the tagger is silently dead in Actions (docs/16 §4).
!data/reference/nomenclature/
!data/reference/nomenclature/*.json

# Session scratch. Canon has assumed since Session 18 that this was already ignored ("scratchpad is
# gitignored -> gone on re-clone") — it was NOT, and `git add -A` would have staged 21 files including
# Article XIII name-extraction tooling. The repo goes public, so this is a privacy floor, not hygiene.
scratchpad/

# Site build output (Vercel builds it; not committed)
site/dist/
site/.astro/

# Search rebuildable intermediates (large; regenerate via pipeline.search.harness.build_phrase_index)
data/derived/search/*.jsonl
data/derived/search/cross_party_daily.json
data/derived/search/cross_party_daily.*.json
data/derived/search/text_features.jsonl
