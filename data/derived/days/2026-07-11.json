        "fragments": [
          {
            "text": "the landmark 21st century road to housing act",
            "statement": "sha256:8086a3dba0e119bc7c5445e2cc7ab69ce5844c4b537981744df9d0af0bc20f5a"
          },
          {
            "text": "statement after the 21st century road to housing act became law",
            "statement": "sha256:674b0961da5167a2480a40ce7aa7d78fc84110b060bf22adc104a0cd3f244867"
          },
          {
            "text": "the bipartisan 21st century road to housing act officially became law",
